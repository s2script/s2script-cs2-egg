{
  // bool — Hide the "loop shutdown" disconnect message players see when someone reconnects for an addon (mm_block_disconnect_messages).
  "addons_block_disconnect_messages": false,
  // bool — Remember which addons each client has, so map changes and rejoins skip the reconnects (mm_cache_clients_with_addons).
  "addons_cache_clients": false,
  // float — Seconds a remembered list lasts after the client was last seen; 0 is forever (mm_cache_clients_duration).
  "addons_cache_duration": 0,
  // string — Workshop addons only clients load, separated by commas or spaces (mm_client_extra_addons).
  "addons_client_extra": "",
  // float — Seconds a client may stay on its first addon download before it is dropped; 0 never drops (mm_addon_connection_timeout).
  "addons_connection_timeout": 30,
  // string — Workshop addons to download, mount on the server and send to every client, in load order, separated by commas or spaces (MultiAddonManager's mm_extra_addons).
  "addons_extra": "",
  // float — Seconds a client has to reconnect after being sent away for an extra addon, for that addon to count as downloaded (mm_extra_addons_timeout).
  "addons_extra_timeout": 10,
  // bool — Ask Steam for an update every time an addon is mounted, even when it is installed (mm_addon_mount_download).
  "addons_mount_download": false
}
