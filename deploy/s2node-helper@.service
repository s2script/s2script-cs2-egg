# Staged template only. A root-owned per-instance drop-in MUST set User to the
# actual non-root host volume UID and Group/SupplementaryGroups to access_gid.
[Unit]
Description=S2Script fixed-volume stopped helper (%i)
[Service]
# Deliberately non-runnable until the operator supplies the identity drop-in.
User=s2node-helper-unconfigured
ExecStart=/usr/local/bin/s2node helper-run --config /etc/s2node/helpers/%i.json
RuntimeDirectory=s2node-helper-%i
RuntimeDirectoryMode=0770
UMask=0007
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
# Ordinary Unix permissions isolate private files. For additional filesystem
# sandboxing, use ONE reviewed common-parent mount for source and stage; separate
# ReadOnlyPaths/ReadWritePaths bind mounts can make hardlinks fail with EXDEV.
TimeoutStopSec=30
[Install]
WantedBy=multi-user.target
