[Unit]
Description=S2Script optional node services
After=network.target

[Service]
Type=simple
User=s2node
Group=s2node
# Set SupplementaryGroups in an operator drop-in for registered access_gid values.
ExecStart=/usr/local/bin/s2node run --config /etc/s2node/node.json
Restart=on-failure
RestartSec=5
RuntimeDirectory=s2node
RuntimeDirectoryMode=0700
StateDirectory=s2node
StateDirectoryMode=0700
UMask=0007
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Add registered egg directories and enabled module stores in an operator drop-in.
ReadWritePaths=/run/s2node /var/lib/s2node
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
